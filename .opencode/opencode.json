{
  "$schema": "https://opencode.ai/config.json",

  // Robotnik is the only agent that delegates. Making it the default
  // means a bare `opencode` lands on the delegator rather than on a subagent
  // that cannot fan work out.
  // The value must be the exact agent name, which is the file name without
  // the extension. A case mismatch (e.g. "Robotnik") is treated as invalid
  // and silently falls back to the built-in `build` agent.
  "default_agent": "robotnik",

  // v2.0.18 reports subagent_depth as an unsupported legacy setting and omits
  // it; it is kept for compatibility and for versions that honor it. The
  // depth-1 guarantee that actually binds comes from `task` permissions:
  // only robotnik has task allows, all ten workers have `task: deny`.
  "subagent_depth": 1,

  // Compaction is disabled for every agent (operator decision 2026-11-12).
  // The planning doc is the durable context; a session context that fills
  // up hard-fails the turn instead of compacting.
  "compaction": {
    "auto": false
  },

  // Caps a single tool result at 400 lines. A `git log` or a test dump that
  // blows past this would otherwise eat context that a compaction cannot
  // fully restore.
  "tool_output": {
    "max_lines": 400
  }
}
