#!/usr/bin/env bash
# rt-lib -- shared plumbing for the scripts/remote remote visual-control tools.
#
# Sourced by rt-shot, rt-ocr, rt-type, rt-key, rt-click, rt-status and
# rt-uinput. Not meant to be run on its own.
#
# Credentials rule carried by every tool in this directory: a credential is
# read from a file under ~/AI/secrets at run time only. It is never echoed,
# never placed in argv (so never in `ps` or shell history), never committed,
# never written into a planning doc or a log. The RDP path feeds the argument
# lines through a pipe into the tool's stdin, so no credential file is created
# by these scripts either.

set +x                                   # never trace: a trace line would print commands
umask 077                                # anything a tool does create is owner-only

# --- configuration, every value overridable by the caller --------------------
RT_SSH_USER="${RT_SSH_USER:-howard}"                       # target login user
RT_SSH_PASS_FILE="${RT_SSH_PASS_FILE:-$HOME/AI/secrets/scm_draft_pass.md}"
RT_RDP_PASS_FILE="${RT_RDP_PASS_FILE:-$HOME/AI/secrets/scm_draft_rdp_pass.md}"
RT_BUILD_DIR="${RT_BUILD_DIR:-$HOME/.cache/team-chaotix/remote-build}"
RT_RDINPUT="${RT_RDINPUT:-${RT_BUILD_DIR}/rdp-input}"      # built by scripts/remote/rt-build
RT_RDPOINTER="${RT_RDPOINTER:-${RT_BUILD_DIR}/rdp-pointer}"
RT_TARGET_TMP="${RT_TARGET_TMP:-/tmp}"                     # target-side scratch directory
RT_TARGET_UID="${RT_TARGET_UID:-1000}"                     # target session owner, verified by rt-status
RT_SCREENSHOT_BIN="${RT_SCREENSHOT_BIN:-/usr/bin/gnome-screenshot-tool}"  # shipped by gnome-shell 49
RT_RDP_W="${RT_RDP_W:-1920}"                               # desktop geometry advertised to the server
RT_RDP_H="${RT_RDP_H:-1080}"
# Host key pinning (TASK-0042 `## Security` R2 finding 1). With verification switched off, any host on
# the path could answer for 192.168.1.99, and `sshpass -f` then handed it the target SSH password.
# Verification is on, and it reads the pinned keys the repository publishes at scripts/remote/
# known_hosts first, so the demo target authenticates against a checked-in key. The operator's own
# known_hosts follows in the same list so the tools still reach hosts they already know (test VMs).
RT_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"  # directory holding rt-lib itself
RT_SSH_KNOWN_HOSTS="${RT_SSH_KNOWN_HOSTS:-${RT_LIB_DIR}/known_hosts}"
# Verified on this host (OpenSSH_9.9p1): a comma inside one -o UserKnownHostsFile is taken as a
# literal file name, so the two files are passed as two -o options, which OpenSSH treats as a list.
RT_SSH_OPTS=(-o StrictHostKeyChecking=yes -o UserKnownHostsFile="${RT_SSH_KNOWN_HOSTS}" -o UserKnownHostsFile="${HOME}/.ssh/known_hosts" -o ConnectTimeout=10)

# RDP channel posture (TASK-0042 `## Security` finding 2, `Omega`'s `O1` ruling 2026-11-26 00:06 UTC).
# The target's gnome-remote-desktop daemon presents a self-issued certificate with no Subject
# Alternative Name (TASK-0041 `## Implementation`, dispatch T6), so name matching against it can never
# succeed and chain validation is not an available posture on this LAN. The client-side mechanism that
# does work is the SHA-256 fingerprint of that certificate, pinned below: measured through the live
# listener and through the tunnel, `/cert:fingerprint:sha256:<pin>` authenticates at rc 0 while
# `/cert:deny` and a wrong pin abort. The verify-everything-and-continue option finding 2 is about is
# not used anywhere in this tree, and tests/selftest.sh fails the moment its name reappears under
# scripts/. The pin is a public certificate fingerprint, not secret material, and it lives in this one
# variable so re-keying the daemon is a one-line change.
RT_RDP_CERT_PIN="${RT_RDP_CERT_PIN:-84b12d76aae393937a27dca9767efa7685778352f1c1b0a6b919b6079f18bab4}"
RT_RDP_TARGET_PORT="${RT_RDP_TARGET_PORT:-3389}"          # the listener's port on the target
RT_RDP_TUNNEL_PORT="${RT_RDP_TUNNEL_PORT:-3401}"          # our loopback port, the near end of the forward
RT_RDP_TUNNEL="${RT_RDP_TUNNEL:-1}"                       # 1 = RDP inside the pinned SSH connection
RT_STATE_DIR="${RT_STATE_DIR:-$HOME/.cache/team-chaotix/remote-run}"  # records for live forwards
# How long a caller waits for a forward to start listening, and the pause between polls. The same window
# is used for a forward this shell opens and for one another process opened that this call borrows
# (dispatch `S2`: `rt-tunnel start` and an input tool batched into one message race the 0.5 s the forward
# needs, dispatch `T7` measured 0.54 s at TASK-0041 `## Implementation`).
RT_TUNNEL_WAIT_TRIALS="${RT_TUNNEL_WAIT_TRIALS:-10}"     # polls before a forward is called half-open
RT_TUNNEL_WAIT_MS="${RT_TUNNEL_WAIT_MS:-0.5}"            # seconds between those polls
RT_RDP_V=""                                               # the /v: value, set by rt_rdp_channel
# argv[1] of the team's C tools is an argument *file path* (scripts/rdp-input.c:202 and
# scripts/rdp-pointer.c:83 fopen it directly, no `-` convention), so the argument lines that come down
# a pipe reach them through /dev/stdin. That is the form the booth runner already uses.
RT_RDP_STDIN="${RT_RDP_STDIN:-/dev/stdin}"
RT_TUNNEL_OWNED=0                                         # 1 when this shell started the forward
RT_TUNNEL_PID=""
RT_TUNNEL_HOST=""                                         # host the claim bookkeeping below is for
RT_TUNNEL_CLAIM_ROLE=""                                   # own = started it, use = borrowed it, "" = no claim
RT_TUNNEL_CLAIMED=0                                       # 1 when this shell's claim is recorded in the state file
RT_TUNNEL_KEEPERS=0                                       # live own|keep claims left after a claim write
RT_TUNNEL_USERS=0                                         # live use claims left after a claim write

RT_DRY=0                                                   # 1 when --dry-run was given
RT_HOST="${RT_HOST:-}"                                     # target host, empty until parsed
RT_ARGV=()                                                 # tool-specific arguments survive here

# --- small helpers ------------------------------------------------------------
rt_die()  { printf 'rt: error: %s\n' "$*" >&2; exit 1; }
rt_note() { printf 'rt: %s\n' "$*"; }
rt_have() { command -v "$1" >/dev/null 2>&1; }

# Shared option block, printed by every tool's --help.
# The RDP channel lines are scoped by their own heading to the four tools that open the channel, so
# a tool that never touches RDP prints them as not-applicable rather than as a claim about itself.
rt_common_options() {
  cat <<'EOF'

Shared options
  --host <ip|name>      target host. Required for every real run.
  --user <name>         target ssh user (default howard, or $RT_SSH_USER).
  --ssh-pass-file <p>   path to the ssh credential file (default ~/AI/secrets/scm_draft_pass.md).
  --rdp-pass-file <p>   path to the RDP credential file (default ~/AI/secrets/scm_draft_rdp_pass.md).
  --dry-run             print the exact commands and exit 0. No network, no target, no credential read.
  -h, --help            this text.

RDP channel (rt-type, rt-key, rt-click, rt-tunnel)
  The session runs inside the pinned SSH forward to 127.0.0.1:RT_RDP_TUNNEL_PORT (3401), opened over
  the connection whose host key is pinned in scripts/remote/known_hosts, and the client pins the
  daemon's certificate fingerprint with /cert:fingerprint:sha256: read from RT_RDP_CERT_PIN. A wrong
  pin aborts, and the accept-any certificate option is used nowhere in this tree.
  rt-tunnel start holds one forward for a whole run, rt-tunnel stop is its inverse, and a tool that
  borrows a live forward leaves it running for its owner. RT_RDP_TUNNEL=0 selects the fallback, a
  direct /v:<host>:3389 under the same certificate pin.
EOF
}

# Consumes the shared flags, keeps everything else in RT_ARGV.
rt_parse_common() {
  RT_ARGV=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)          [ "$#" -ge 2 ] || rt_die "--host needs a value"; RT_HOST="$2"; shift 2 ;;
      --user)          [ "$#" -ge 2 ] || rt_die "--user needs a value"; RT_SSH_USER="$2"; shift 2 ;;
      --ssh-pass-file) [ "$#" -ge 2 ] || rt_die "--ssh-pass-file needs a path"; RT_SSH_PASS_FILE="$2"; shift 2 ;;
      --rdp-pass-file) [ "$#" -ge 2 ] || rt_die "--rdp-pass-file needs a path"; RT_RDP_PASS_FILE="$2"; shift 2 ;;
      --dry-run)       RT_DRY=1; shift ;;
      --)              shift; while [ "$#" -gt 0 ]; do RT_ARGV+=("$1"); shift; done ;;
      *)               RT_ARGV+=("$1"); shift ;;
    esac
  done
}

# A host is required for a real run. A dry run may print a placeholder instead.
rt_host_or_placeholder() {
  if [ -n "$RT_HOST" ]; then printf '%s' "$RT_HOST"; else printf '<host>'; fi
}

rt_require_host() {
  if [ "$RT_DRY" -eq 1 ]; then return 0; fi
  [ -n "$RT_HOST" ] || rt_die "--host is required for a real run"
}

# Warn, do not fail, when a credential file is readable by more than its owner.
# The known state of ~/AI/secrets/scm_draft_pass.md on the controller is 644;
# that is recorded as an open hygiene item for the review chain rather than
# silently fixed here.
rt_secret_mode_warn() {
  local f="$1"
  local mode
  mode="$(stat -c '%a' "$f" 2>/dev/null || echo unknown)"
  if [ "$mode" != "600" ] && [ "$mode" != "400" ]; then
    rt_note "warning: $f is mode $mode, AGENTS.md section 4 requires 600"
  fi
}

rt_require_secret_file() {
  local f="$1"
  [ -f "$f" ] || rt_die "credential file not found: $f"
  rt_secret_mode_warn "$f"
}

# --- ssh and scp wrappers -----------------------------------------------------
# The credential reaches sshpass through -f <file>, never through argv.
rt_ssh() {
  local host="$1"; shift
  local cmd="$*"
  if [ "$RT_DRY" -eq 1 ]; then
    printf 'would run: sshpass -f %s ssh %s %s@%s %s\n' \
      "$RT_SSH_PASS_FILE" "${RT_SSH_OPTS[*]}" "$RT_SSH_USER" "$(rt_host_or_placeholder)" "$cmd"
    return 0
  fi
  rt_require_host
  rt_require_secret_file "$RT_SSH_PASS_FILE"
  sshpass -f "$RT_SSH_PASS_FILE" ssh "${RT_SSH_OPTS[@]}" "${RT_SSH_USER}@${RT_HOST}" "$cmd"
}

# Copy one file from the target to a local path.
rt_fetch() {
  local host="$1" remote="$2" local_path="$3"
  if [ "$RT_DRY" -eq 1 ]; then
    printf 'would run: sshpass -f %s scp %s %s@%s:%s %s\n' \
      "$RT_SSH_PASS_FILE" "${RT_SSH_OPTS[*]}" "$RT_SSH_USER" "$(rt_host_or_placeholder)" "$remote" "$local_path"
    return 0
  fi
  rt_require_host
  rt_require_secret_file "$RT_SSH_PASS_FILE"
  sshpass -f "$RT_SSH_PASS_FILE" scp "${RT_SSH_OPTS[@]}" "${RT_SSH_USER}@${RT_HOST}:${remote}" "$local_path"
}

# Copy one local file to the target.
rt_send() {
  local host="$1" local_path="$2" remote="$3"
  if [ "$RT_DRY" -eq 1 ]; then
    printf 'would run: sshpass -f %s scp %s %s %s@%s:%s\n' \
      "$RT_SSH_PASS_FILE" "${RT_SSH_OPTS[*]}" "$local_path" "$RT_SSH_USER" "$(rt_host_or_placeholder)" "$remote"
    return 0
  fi
  rt_require_host
  rt_require_secret_file "$RT_SSH_PASS_FILE"
  sshpass -f "$RT_SSH_PASS_FILE" scp "${RT_SSH_OPTS[@]}" "$local_path" "${RT_SSH_USER}@${RT_HOST}:${remote}"
}

# Environment that reaches the target's live graphical session over plain ssh.
# Verified on 192.168.1.99: the ssh environment carries no WAYLAND_DISPLAY and
# no DISPLAY, so the user D-Bus bus has to be named explicitly.
rt_session_env() {
  printf 'XDG_RUNTIME_DIR=/run/user/%s DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus' \
    "$RT_TARGET_UID" "$RT_TARGET_UID"
}

# --- the RDP channel: pinned SSH forward plus a pinned server certificate ------
# `Omega`'s ruling on `TASK-0042 ## Security` finding 2 names a substitution, not a deletion. The
# credential-bearing channel has to authenticate the far end, and here it does so twice: the RDP
# session runs inside the SSH connection whose host key is pinned above, so no 3389 packet crosses the
# LAN at all, and the client pins the daemon's certificate fingerprint. Both halves were measured end
# to end by dispatch `T6` (TASK-0041 `## Implementation`, and the prototype at
# /home/howard/AI/booth-2026/t0042/t6_ssh_tunnel_test.sh). Removing the certificate option without
# substituting the pin would break the loop: with no `/cert:` option FreeRDP prompts interactively and
# aborts when stdin is not a terminal.
#
# A live forward is described by a state file in $RT_STATE_DIR named after the host and the local port.
# Line 1 holds the forward's pid, exactly as scripts/remote/rt-tunnel status and stop read it. Every line
# after line 1 is a claim on that forward, `<role> <pid>`: `own` is the process that started it, `use` is a
# process that borrowed it, and `keep` is a forward holding itself because its starter detached on purpose
# (scripts/remote/rt-tunnel start). The file never holds a credential and is mode 600 under the umask 077
# set above. Claims are what stop one tool reaping a forward another tool is still using.

rt_tunnel_key() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

rt_tunnel_state_file() {
  printf '%s/tunnel-%s-%s.pid' "$RT_STATE_DIR" "$(rt_tunnel_key "$1")" "$RT_RDP_TUNNEL_PORT"
}

rt_tunnel_forward_spec() {
  printf '127.0.0.1:%s:127.0.0.1:%s' "$RT_RDP_TUNNEL_PORT" "$RT_RDP_TARGET_PORT"
}

# Is anything listening on our loopback port? `ss` reads the socket table without dialing anything;
# bash's /dev/tcp is the fallback, and dialing the port through it goes out through the forward.
rt_tunnel_listening() {
  if rt_have ss; then
    ss -tln 2>/dev/null | grep -qE "127\.0\.0\.1:${RT_RDP_TUNNEL_PORT}([[:space:]]|$)"
    return $?
  fi
  (exec 3<>"/dev/tcp/127.0.0.1/${RT_RDP_TUNNEL_PORT}") 2>/dev/null
}

# Does that pid look like our own forward rather than a pid recycled by an unrelated process?
rt_tunnel_pid_is_ours() {
  local pid="$1" spec="$2" cmdline
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  if [ -r "/proc/${pid}/cmdline" ]; then
    cmdline="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)"
    case "$cmdline" in *"${spec}"*) return 0 ;; *) return 1 ;; esac
  fi
  return 0
}

# Wait for the loopback port to accept, $1 being the pid believed to hold the forward. Both paths use it:
# a forward this shell starts, and a forward another process started that this call is about to borrow.
# Returns 0 when listening, 1 when the window ran out, 2 when the pid died first.
rt_tunnel_wait() {
  local pid="$1" i
  for (( i = 1; i <= RT_TUNNEL_WAIT_TRIALS; i++ )); do
    if rt_tunnel_listening; then return 0; fi
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then return 2; fi
    sleep "$RT_TUNNEL_WAIT_MS"
  done
  if rt_tunnel_listening; then return 0; fi
  return 1
}

rt_tunnel_lock_file() { printf '%s.lock' "$(rt_tunnel_state_file "$1")"; }

# Read-modify-write of one forward's claim list.
#   $1 host  $2 add|drop  $3 own|use|keep  $4 pid of the claim being written  $5 forward pid to record
#      as line 1, only when the record is being created.
# add appends the claim. drop removes it. Both prune every claim whose pid is dead. Sets RT_TUNNEL_KEEPERS
# and RT_TUNNEL_USERS to the live own|keep and use claims left, which is what rt_rdp_channel_release
# decides the reap from. The whole rewrite is done under an exclusive flock on the companion lock file and
# lands as one mv, so two callers launched in one batched message (AGENTS.md section 17) cannot lose each
# other's claim. Returns 1 rather than writing an unlocked or partial record.
rt_tunnel_claims_write() {
  local host="$1" action="$2" role="$3" claim_pid="$4" fwd="${5:-}"
  local state lock tmp r p n rc=0
  state="$(rt_tunnel_state_file "$host")"
  lock="$(rt_tunnel_lock_file "$host")"
  RT_TUNNEL_KEEPERS=0
  RT_TUNNEL_USERS=0
  case "$action" in add|drop) : ;; *) return 1 ;; esac
  case "$role" in own|use|keep) : ;; *) return 1 ;; esac
  case "$claim_pid" in ''|*[!0-9]*) return 1 ;; esac
  if [ "$action" = drop ] && [ ! -f "$state" ]; then return 0; fi
  if [ "$action" = add ] && [ -z "$fwd" ] && [ ! -f "$state" ]; then return 1; fi
  mkdir -p "$RT_STATE_DIR" 2>/dev/null || return 1
  chmod 700 "$RT_STATE_DIR" 2>/dev/null || true
  {
    if rt_have flock; then
      if ! flock 9; then rc=1; fi
    else
      printf 'rt: warning: flock is not available, forward claims are unlocked\n' >&2
    fi
    if [ "$rc" -eq 0 ]; then
      tmp="${state}.claims"
      if [ -n "$fwd" ]; then
        printf '%s\n' "$fwd" > "$tmp" || rc=1
      else
        head -n 1 "$state" > "$tmp" || rc=1
      fi
      if [ "$rc" -eq 0 ] && [ -f "$state" ]; then
        n=0
        while read -r r p; do
          n=$((n + 1))
          if [ "$n" -eq 1 ]; then continue; fi              # line 1 is the forward pid, not a claim
          case "$r" in own|use|keep) : ;; *) continue ;; esac
          case "$p" in ''|*[!0-9]*) continue ;; esac
          if [ "$r" = "$role" ] && [ "$p" = "$claim_pid" ]; then continue; fi
          if ! kill -0 "$p" 2>/dev/null; then continue; fi
          case "$r" in
            own|keep) RT_TUNNEL_KEEPERS=$((RT_TUNNEL_KEEPERS + 1)) ;;
            *)        RT_TUNNEL_USERS=$((RT_TUNNEL_USERS + 1)) ;;
          esac
          printf '%s %s\n' "$r" "$p" >> "$tmp" || rc=1
        done < "$state"
      fi
      if [ "$rc" -eq 0 ] && [ "$action" = add ]; then
        printf '%s %s\n' "$role" "$claim_pid" >> "$tmp" || rc=1
        case "$role" in
          own|keep) RT_TUNNEL_KEEPERS=$((RT_TUNNEL_KEEPERS + 1)) ;;
          *)        RT_TUNNEL_USERS=$((RT_TUNNEL_USERS + 1)) ;;
        esac
      fi
      if [ "$rc" -eq 0 ]; then
        chmod 600 "$tmp" 2>/dev/null || true
        mv -f "$tmp" "$state" || rc=1
      else
        rm -f "$tmp" 2>/dev/null || true
      fi
    fi
  } 9>"$lock" || rc=1
  if [ "$rc" -ne 0 ]; then return 1; fi
  return 0
}

# Decide the channel and set RT_RDP_V. Call it from the tool's own shell, before any pipeline: a
# background ssh started inside a pipeline subshell cannot be reaped by the tool's exit trap.
rt_rdp_channel() {
  local host="$1" state pid rc
  [ -n "$host" ] || rt_die "rt_rdp_channel needs a host"
  if [ "$RT_RDP_TUNNEL" -eq 0 ]; then
    RT_RDP_V="${host}:${RT_RDP_TARGET_PORT}"
    rt_note "warning: RT_RDP_TUNNEL=0, RDP dials ${RT_RDP_V} across the LAN. The certificate pin still applies."
    return 0
  fi
  RT_TUNNEL_HOST="$host"
  state="$(rt_tunnel_state_file "$host")"
  if [ -f "$state" ]; then
    read -r pid < "$state" || pid=""
    if rt_tunnel_pid_is_ours "$pid" "$(rt_tunnel_forward_spec)"; then
      # A forward this call did not start gets the same wait window a forward it starts itself gets. The
      # old code died here on the spot and told the operator to run `rt-tunnel stop`, which tears down a
      # perfectly healthy forward that is 0.5 s into coming up (`S2` should-fix, TASK-0041 `## Review`).
      rc=0
      rt_tunnel_wait "$pid" || rc=$?
      if [ "$rc" -eq 0 ]; then
        RT_RDP_V="127.0.0.1:${RT_RDP_TUNNEL_PORT}"
        RT_TUNNEL_OWNED=0                    # a forward this run borrowed: reuse it, never kill it
        RT_TUNNEL_PID="$pid"
        RT_TUNNEL_CLAIM_ROLE="use"
        if rt_tunnel_claims_write "$host" add use "$$"; then
          RT_TUNNEL_CLAIMED=1
        else
          rt_note "warning: the borrowed forward at ${state} could not be claim-recorded, so this call cannot protect it from another caller's exit"
        fi
        return 0
      fi
      if [ "$rc" -eq 2 ]; then
        rt_note "the forward for ${host} (pid ${pid}) exited while this call waited ${RT_TUNNEL_WAIT_TRIALS} x ${RT_TUNNEL_WAIT_MS}s for 127.0.0.1:${RT_RDP_TUNNEL_PORT}"
      else
        rt_die "the forward for ${host} (pid ${pid}) is alive but 127.0.0.1:${RT_RDP_TUNNEL_PORT} did not start listening within ${RT_TUNNEL_WAIT_TRIALS} x ${RT_TUNNEL_WAIT_MS}s. Look at it with scripts/remote/rt-tunnel --host ${host} status first, and run scripts/remote/rt-tunnel --host ${host} stop only if status says the record is not a forward that is still coming up."
      fi
    fi
    rt_note "clearing the stale forward record at ${state}"
    rm -f "$state" "$(rt_tunnel_lock_file "$host")" "${state}.claims"
  fi
  if rt_tunnel_listening; then
    rt_die "127.0.0.1:${RT_RDP_TUNNEL_PORT} is held by a process this tool cannot identify as its own forward. Free the port or set RT_RDP_TUNNEL_PORT; refusing to send a credential into an unknown socket."
  fi
  mkdir -p "$RT_STATE_DIR" || rt_die "cannot create the state directory ${RT_STATE_DIR}"
  chmod 700 "$RT_STATE_DIR" 2>/dev/null || true
  rt_require_host
  rt_require_secret_file "$RT_SSH_PASS_FILE"
  sshpass -f "$RT_SSH_PASS_FILE" ssh "${RT_SSH_OPTS[@]}" -N -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
    -L "$(rt_tunnel_forward_spec)" "${RT_SSH_USER}@${host}" &
  RT_TUNNEL_PID=$!
  RT_TUNNEL_OWNED=1
  RT_TUNNEL_CLAIM_ROLE="own"
  # The record is written only once the port is listening, so a forward that never came up never leaves a
  # pid file for the next caller to trip over.
  rc=0
  rt_tunnel_wait "$RT_TUNNEL_PID" || rc=$?
  if [ "$rc" -eq 0 ]; then
    if rt_tunnel_claims_write "$host" add own "$$" "$RT_TUNNEL_PID"; then
      RT_TUNNEL_CLAIMED=1
    else
      rt_note "warning: the forward is up but its claim could not be recorded at ${state}; scripts/remote/rt-tunnel --host ${host} stop is the inverse"
    fi
    RT_RDP_V="127.0.0.1:${RT_RDP_TUNNEL_PORT}"
    return 0
  fi
  if [ "$rc" -eq 2 ]; then
    rt_die "the ssh forward for ${host} exited before it forwarded anything. Check the pinned host key for ${host} in ${RT_SSH_KNOWN_HOSTS}."
  fi
  # The forward is alive and never forwarded anything: kill this shell's own child directly, there is no
  # claim to consult yet.
  kill "$RT_TUNNEL_PID" 2>/dev/null || true
  wait "$RT_TUNNEL_PID" 2>/dev/null || true
  rt_die "the ssh forward never opened 127.0.0.1:${RT_RDP_TUNNEL_PORT} for ${host}"
}

# Release this shell's claim on a forward and reap the forward only when nothing else is holding it.
#   own, still owned  drop the claim. Reap only when no live claim of any kind is left. When another live
#                     process is using the forward it stays up and says so, which is the fix for the tool
#                     that used to reap a forward out from under a concurrent caller (`S2` should-fix,
#                     TASK-0041 `## Review`, and booth code/booth_loop.py opens and closes one every cycle).
#   own, detached     the caller cleared RT_TUNNEL_OWNED on purpose (scripts/remote/rt-tunnel start): the
#                     claim becomes a keep claim held by the forward's own pid, so the forward outlives
#                     this shell and no later tool reaps it.
#   use               drop the claim, never reap while a keeper or another user is live, and reap when the
#                     opener is gone and this shell was the last live user, so a forward does not sit on the
#                     loopback port with nobody left who will stop it.
rt_rdp_channel_release() {
  local host="${RT_TUNNEL_HOST:-}" role="${RT_TUNNEL_CLAIM_ROLE:-}" fwd="${RT_TUNNEL_PID:-}" others state
  state="$(rt_tunnel_state_file "${host:-none}")"
  if [ -z "$host" ] || [ -z "$role" ] || [ "${RT_TUNNEL_CLAIMED:-0}" -ne 1 ]; then
    RT_TUNNEL_OWNED=0
    RT_TUNNEL_PID=""
    return 0
  fi
  if [ "$role" = own ] && [ "$RT_TUNNEL_OWNED" -eq 0 ]; then
    if rt_tunnel_claims_write "$host" add keep "$fwd" \
       && rt_tunnel_claims_write "$host" drop own "$$"; then
      rt_note "forward left running for the rest of the run, pid ${fwd}, record ${state}"
    else
      rt_note "warning: the keeper claim for pid ${fwd} could not be recorded at ${state}; the forward may outlive the run. Inverse: scripts/remote/rt-tunnel --host ${host} stop"
    fi
    RT_TUNNEL_CLAIMED=0
    RT_TUNNEL_CLAIM_ROLE=""
    RT_TUNNEL_OWNED=0
    RT_TUNNEL_PID=""
    return 0
  fi
  if ! rt_tunnel_claims_write "$host" drop "$role" "$$"; then
    rt_note "warning: the forward record at ${state} could not be updated, so pid ${fwd} is being left running. Inverse: scripts/remote/rt-tunnel --host ${host} stop"
    RT_TUNNEL_CLAIMED=0
    RT_TUNNEL_CLAIM_ROLE=""
    return 0
  fi
  others=$((RT_TUNNEL_KEEPERS + RT_TUNNEL_USERS))
  if [ "$others" -gt 0 ]; then
    rt_note "leaving the forward up for ${others} other live holder(s), record ${state}; inverse: scripts/remote/rt-tunnel --host ${host} stop"
    RT_TUNNEL_CLAIMED=0
    RT_TUNNEL_CLAIM_ROLE=""
    RT_TUNNEL_OWNED=0
    return 0
  fi
  if [ -n "$fwd" ]; then
    kill "$fwd" 2>/dev/null || true
    wait "$fwd" 2>/dev/null || true
  fi
  rm -f "$state" "$(rt_tunnel_lock_file "$host")" "${state}.claims"
  RT_TUNNEL_CLAIMED=0
  RT_TUNNEL_CLAIM_ROLE=""
  RT_TUNNEL_OWNED=0
  RT_TUNNEL_PID=""
  return 0
}

# --- rdp argument lines -------------------------------------------------------
# One argument per line in the xfreerdp form the team's own C tools read.
# The password line is produced by reading the secret file at run time and is
# piped into the tool's stdin: no credential file, no credential in argv.
# `/v:` is the loopback end of the pinned forward unless RT_RDP_TUNNEL=0 says otherwise, and
# `/cert:fingerprint:sha256:` is the pinned identity of the far end in every mode.
rt_rdp_args() {
  local host="$1" v="$RT_RDP_V"
  local cert_line="/cert:fingerprint:sha256:${RT_RDP_CERT_PIN}"   # the only identity line this emits
  if [ "$RT_DRY" -eq 1 ]; then
    if [ -z "$v" ]; then
      if [ "$RT_RDP_TUNNEL" -eq 1 ]; then
        v="127.0.0.1:${RT_RDP_TUNNEL_PORT}"
      else
        v="$(rt_host_or_placeholder)"
      fi
    fi
    printf '/v:%s\n/u:%s\n/p:<from %s>\n%s\n/w:%s\n/h:%s\n+disp\n' \
      "$v" "$RT_SSH_USER" "$RT_RDP_PASS_FILE" "$cert_line" "$RT_RDP_W" "$RT_RDP_H"
    return 0
  fi
  [ -n "$v" ] || rt_die "rt_rdp_channel was not called for ${host}, so no RDP endpoint is decided. Refusing to connect."
  rt_require_host
  rt_require_secret_file "$RT_RDP_PASS_FILE"
  printf '/v:%s\n/u:%s\n/p:%s\n%s\n/w:%s\n/h:%s\n+disp\n' \
    "$v" "$RT_SSH_USER" "$(head -n 1 "$RT_RDP_PASS_FILE")" "$cert_line" "$RT_RDP_W" "$RT_RDP_H"
}

# Release a forward this shell started on any exit path. A tool that sets its own EXIT trap chains to
# this one, see rt-click.
trap 'rt_rdp_channel_release' EXIT

# Resolve a built C tool, with an actionable message when it has not been built.
rt_tool_bin() {
  local name="$1" path="$2"
  [ -x "$path" ] && { printf '%s' "$path"; return 0; }
  rt_die "$name not built yet. Run scripts/remote/rt-build first (expected at $path)."
}
